#ifndef FLUIR_BYTECODE_VERSION_HPP_HPP
#define FLUIR_BYTECODE_VERSION_HPP_HPP

// ${AUTOGENERATED_WARNING}

#include <cstdint>

namespace fluir {
    struct Version {
        std::uint8_t major;
        std::uint8_t minor;
        std::uint8_t patch;

        friend bool operator==(const Version&, const Version&) = default;
    };

    constexpr Version CURRENT_VERSION{
        .major = ${CMAKE_PROJECT_VERSION_MAJOR},
        .minor = ${CMAKE_PROJECT_VERSION_MINOR},
        .patch = ${CMAKE_PROJECT_VERSION_PATCH},
    };
}

#endif
