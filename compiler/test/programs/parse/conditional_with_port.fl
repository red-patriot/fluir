<fluir>
  <header>
    <version>
      <major>0</major>
      <minor>1</minor>
      <patch>3</patch>
    </version>
  </header>
  <function name="main" id="1" x="0" y="0" z="0" w="1000" h="1000">
    <body>
      <constant id="1" x="6" y="10" z="1" w="8" h="5">
        <bool>true</bool>
      </constant>
      <conditional id="2" x="10" y="3" z="1" w="500" h="500">
        <condition outer="3" inner="1" y="10"/>
        <input>
          <port outer="3" inner="1" y="10"/>
          <port outer="4" inner="2" y="20"/>
        </input>
        <output>
          <port outer="5" inner="4" y="10"/>
        </output>
        <then id="0" h="250">
          <body>
            <binary id="3" x="35" y="3" z="2" w="5" h="5" operator="/"/>
            <conduit id="7" input="4">
              <output target="3" index="0"/>
            </conduit>
            <conduit id="8" input="2" index="0">
              <output target="3" index="1"/>
            </conduit>
            <conduit id="9" input="3" index="0">
              <output target="5"/>
            </conduit>
          </body>
        </then>
        <else id="1" h="250">
          <body>
          </body>
        </else>
      </conditional>
    </body>
  </function>
</fluir>
