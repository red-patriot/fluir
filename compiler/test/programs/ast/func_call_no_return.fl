            <conduit id="3" input="1">
                <output target="2" index="0"/>
            </conduit>
        </body>
    </function>
    <function name="bar" id="2" x="200" y="200" z="1" w="100" h="100">
        <input x="0" y="30" z="0" w="10" h="30">
            <param name="x" id="2" type="i32"/>
        </input>
        <body></body>
    </function>
